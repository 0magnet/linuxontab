+/* Open the listen sockets, like PostmasterMain does. */
+void
+lot_server_listen(void)
+{
+	char	   *rawstring;
+	List	   *elemlist;
+	ListCell   *l;
+	char	   *inherited = getenv("LOT_PG_LISTEN_FDS");
+
+	if (inherited != NULL)
+	{
+		/* re-exec'd for another database: sockets handed over */
+		rawstring = pstrdup(inherited);
+		for (char *tok = strtok(rawstring, ","); tok; tok = strtok(NULL, ","))
+			if (lot_nlisten < LOT_MAXLISTEN)
+				lot_listen_socks[lot_nlisten++] = atoi(tok);
+		unsetenv("LOT_PG_LISTEN_FDS");
+	}
+	else
+	{
+		if (ListenAddresses && ListenAddresses[0] != '\0')
+		{
+			rawstring = pstrdup(ListenAddresses);
+			if (!SplitGUCList(rawstring, ',', &elemlist))
+				ereport(FATAL,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("invalid list syntax in parameter \"%s\"",
+								"listen_addresses")));
+			foreach(l, elemlist)
+			{
+				char	   *curhost = (char *) lfirst(l);
+
+				if (ListenServerPort(AF_UNSPEC,
+									 strcmp(curhost, "*") == 0 ? NULL : curhost,
+									 (unsigned short) PostPortNumber, NULL,
+									 lot_listen_socks, &lot_nlisten,
+									 LOT_MAXLISTEN) != STATUS_OK)
+					ereport(WARNING,
+							(errmsg("could not create listen socket for \"%s\"",
+									curhost)));
+			}
+		}
+
+		if (Unix_socket_directories && Unix_socket_directories[0] != '\0')
+		{
+			rawstring = pstrdup(Unix_socket_directories);
+			if (!SplitDirectoriesString(rawstring, ',', &elemlist))
+				ereport(FATAL,
+						(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
+						 errmsg("invalid list syntax in parameter \"%s\"",
+								"unix_socket_directories")));
+			foreach(l, elemlist)
+			{
+				char	   *socketdir = (char *) lfirst(l);
+
+				if (ListenServerPort(AF_UNIX, NULL,
+									 (unsigned short) PostPortNumber, socketdir,
+									 lot_listen_socks, &lot_nlisten,
+									 LOT_MAXLISTEN) != STATUS_OK)
+					ereport(WARNING,
+							(errmsg("could not create Unix-domain socket in directory \"%s\"",
+									socketdir)));
+			}
+		}
+	}
+
+	if (lot_nlisten == 0)
+		ereport(FATAL,
+				(errmsg("no socket created for listening")));
+	on_proc_exit(lot_server_close_listen, 0);
+
+	for (int i = 0; i < lot_nlisten; i++)
+	{
+		(void) pg_set_noblock(lot_listen_socks[i]);
+		(void) fcntl(lot_listen_socks[i], F_SETFD, FD_CLOEXEC);
+	}
