+/* ----------------------------------------------------------------
+ * LinuxOnTab single-process server, connection side
+ *
+ * The LinuxOnTab wasm guest has no memory shared between processes (each
+ * one is a separate wasm instance), so the postmaster cannot fork backends.
+ * main.c runs a stand-alone backend in "server mode" instead: it listens on
+ * listen_addresses/port and unix_socket_directories itself, and serves one
+ * client at a time over the normal FE/BE protocol (postgres.c drives the
+ * session side).  Further clients wait in the listen backlog; an idle
+ * session (no open transaction) is ended when another client connects, so
+ * psql's \connect (which opens the new connection before closing the old
+ * one) and abandoned idle connections don't block everyone.  A client
+ * asking for another database makes the server shut down cleanly and
+ * re-exec itself for that database, handing over the sockets.  Clients are
+ * trusted: no pg_hba.conf, any existing login role.
+ * ----------------------------------------------------------------
+ */
+#include <fcntl.h>
+#include <poll.h>
+#include "utils/varlena.h"
+#include "utils/wait_event.h"
+
+#define LOT_MAXLISTEN 8
+
+bool		lot_demote_fatal = false;
+static pgsocket lot_listen_socks[LOT_MAXLISTEN];
+static int	lot_nlisten = 0;
+static WaitEventSet *lot_accept_set = NULL;
+static WaitEventSet *lot_idle_set = NULL;
+static ClientSocket lot_pending;	/* accepted while a session was idle */
+static bool lot_have_pending = false;
+static bool lot_handing_off = false;
+static char **lot_handoff_argv = NULL;
+
+static void
+lot_server_close_listen(int code, Datum arg)
+{
+	for (int i = 0; i < lot_nlisten; i++)
+		closesocket(lot_listen_socks[i]);
+	lot_nlisten = 0;
+	/* a re-exec for another database keeps serving on the same sockets */
+	if (!lot_handing_off)
+		RemoveSocketFiles();
+}
