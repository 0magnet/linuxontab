+/*
+ * Called by PostgresMain when the current client is idle (ReadyForQuery
+ * sent, no transaction open): wait until it sends something, or until
+ * another client connects.  In the latter case the idle session is ended
+ * (FATAL 57P01 sent to it) and true is returned; the waiting client is
+ * picked up by the next lot_server_accept().
+ */
+bool
+lot_server_wait_idle(void)
+{
+	if (pq_buffer_remaining_data() > 0 || MyProcPort == NULL)
+		return false;
+
+	if (lot_idle_set == NULL)
+	{
+		/* the client descriptor number never changes (pq_lot_switch_client) */
+		lot_idle_set = CreateWaitEventSet(NULL, lot_nlisten + 2);
+		AddWaitEventToSet(lot_idle_set, WL_LATCH_SET, PGINVALID_SOCKET,
+						  MyLatch, NULL);
+		AddWaitEventToSet(lot_idle_set, WL_SOCKET_READABLE, MyProcPort->sock,
+						  NULL, NULL);
+		for (int i = 0; i < lot_nlisten; i++)
+			AddWaitEventToSet(lot_idle_set, WL_SOCKET_ACCEPT,
+							  lot_listen_socks[i], NULL, NULL);
+	}
+
+	for (;;)
+	{
+		WaitEvent	event;
+		StringInfoData buf;
+
+		if (WaitEventSetWait(lot_idle_set, -1, &event, 1,
+							 WAIT_EVENT_CLIENT_READ) != 1)
+			continue;
+		if (event.events & WL_LATCH_SET)
+		{
+			ResetLatch(MyLatch);
+			CHECK_FOR_INTERRUPTS();
+			continue;
+		}
+		if (event.pos == 1)
+			return false;		/* the current client has something to say */
+		if (AcceptConnection(event.fd, &lot_pending) != STATUS_OK)
+			continue;
+		if (lot_is_cancel_request(lot_pending.sock))
+		{
+			closesocket(lot_pending.sock);
+			continue;
+		}
+		lot_have_pending = true;
+
+		/* say goodbye like a terminated backend would */
+		pq_beginmessage(&buf, PqMsg_ErrorResponse);
+		pq_sendbyte(&buf, PG_DIAG_SEVERITY);
+		pq_sendstring(&buf, "FATAL");
+		pq_sendbyte(&buf, PG_DIAG_SEVERITY_NONLOCALIZED);
+		pq_sendstring(&buf, "FATAL");
+		pq_sendbyte(&buf, PG_DIAG_SQLSTATE);
+		pq_sendstring(&buf, "57P01");
+		pq_sendbyte(&buf, PG_DIAG_MESSAGE_PRIMARY);
+		pq_sendstring(&buf, "terminating idle session: another client connected");
+		pq_sendbyte(&buf, PG_DIAG_MESSAGE_DETAIL);
+		pq_sendstring(&buf, "This single-process PostgreSQL serves one client at a time.");
+		pq_sendbyte(&buf, '\0');
+		pq_endmessage(&buf);
+		(void) pq_flush();
+		elog(LOG, "ending idle session: another client connected");
+		return true;
+	}
+}
+
+static void
+lot_handoff_exec(void)
+{
+	if (!lot_handing_off)
+		return;
+	fflush(NULL);
+	execv(my_exec_path, lot_handoff_argv);
+	write_stderr("could not re-execute \"%s\" for the database switch: %s\n",
+				 my_exec_path, strerror(errno));
+}
+
+/*
+ * The client asked for a database other than the one this process is
+ * attached to (a backend can only ever attach to one).  Shut down cleanly
+ * and re-exec for that database, handing over the listen sockets and this
+ * client (whose startup packet has been read already).  Does not return.
+ */
+void
+lot_server_handoff(Port *port, char **argv)
+{
+	StringInfoData s;
+	ListCell   *l;
+	char		num[32];
+
+	ereport(LOG,
+			(errmsg("restarting for database \"%s\" (one database per server process)",
+					port->database_name)));
+
+	initStringInfo(&s);
+	for (int i = 0; i < lot_nlisten; i++)
+		appendStringInfo(&s, "%d,", dup(lot_listen_socks[i]));	/* no CLOEXEC */
+	setenv("LOT_PG_LISTEN_FDS", s.data, 1);
+	snprintf(num, sizeof(num), "%d", dup(port->sock));
+	setenv("LOT_PG_CLIENT_FD", num, 1);
+	snprintf(num, sizeof(num), "%u", (unsigned int) FrontendProtocol);
+	setenv("LOT_PG_PROTO", num, 1);
+	setenv("LOT_PG_USER", port->user_name, 1);
+	setenv("LOT_PG_DB", port->database_name, 1);
+	resetStringInfo(&s);
+	foreach(l, port->guc_options)
+	{
+		if (s.len > 0)
+			appendStringInfoChar(&s, '\001');
+		appendStringInfoString(&s, (char *) lfirst(l));
+	}
+	setenv("LOT_PG_GUCS", s.data, 1);
+
+	lot_handoff_argv = argv;
+	lot_handing_off = true;
+	atexit(lot_handoff_exec);
+	whereToSendOutput = DestNone;
+	proc_exit(0);
+}
