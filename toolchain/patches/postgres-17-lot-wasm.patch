+			{
+				am_walsender = false;
+				ereport(ERROR,
+						(errcode(ERRCODE_FEATURE_NOT_SUPPORTED),
+						 errmsg("replication connections are not supported by this single-process server")));
+			}
+		}
+		PG_CATCH();
+		{
+			MemoryContextSwitchTo(oldcxt);
+			EmitErrorReport();
+			FlushErrorState();
+			status = STATUS_ERROR;
+		}
+		PG_END_TRY();
