+/*
+ * Wait for the next client, then read its startup packet.  Returns with
+ * MyProcPort describing the client and whereToSendOutput = DestRemote.
+ * Cancel requests, SSL attempts and broken startup packets are answered
+ * (or dropped) here and never returned.
+ */
+Port *
+lot_server_accept(void)
+{
+	Port	   *handoff = lot_adopt_handoff_client();
+
+	if (handoff != NULL)
+		return handoff;
+
+	/*
+	 * Built lazily: MyLatch must already be the shared PGPROC latch, which
+	 * InitProcess() switches to.
+	 */
+	if (lot_accept_set == NULL)
+	{
+		lot_accept_set = CreateWaitEventSet(NULL, lot_nlisten + 1);
+		AddWaitEventToSet(lot_accept_set, WL_LATCH_SET, PGINVALID_SOCKET,
+						  MyLatch, NULL);
+		for (int i = 0; i < lot_nlisten; i++)
+			AddWaitEventToSet(lot_accept_set, WL_SOCKET_ACCEPT,
+							  lot_listen_socks[i], NULL, NULL);
+	}
+
+	for (;;)
+	{
+		WaitEvent	event;
+		ClientSocket client_sock;
+		Port	   *port;
+		char		remote_host[NI_MAXHOST];
+		char		remote_port[NI_MAXSERV];
+		MemoryContext oldcxt;
+		volatile int status;
+
+		if (lot_have_pending)
+		{
+			client_sock = lot_pending;
+			lot_have_pending = false;
+		}
+		else
+		{
+			set_ps_display("waiting for client");
+			if (WaitEventSetWait(lot_accept_set, -1, &event, 1,
+								 WAIT_EVENT_CLIENT_READ) != 1)
+				continue;
+			if (event.events & WL_LATCH_SET)
+			{
+				ResetLatch(MyLatch);
+				CHECK_FOR_INTERRUPTS();
+				continue;
+			}
+			if (!(event.events & WL_SOCKET_ACCEPT))
+				continue;
+			if (AcceptConnection(event.fd, &client_sock) != STATUS_OK)
+				continue;
+		}
+
+		if (MyProcPort == NULL)
+		{
+			oldcxt = MemoryContextSwitchTo(TopMemoryContext);
+			ReserveExternalFD();
+			MyProcPort = pq_init(&client_sock);
+			MemoryContextSwitchTo(oldcxt);
+		}
+		else
+			pq_lot_switch_client(&client_sock);
+		port = MyProcPort;
+
+		remote_host[0] = '\0';
+		remote_port[0] = '\0';
+		(void) pg_getnameinfo_all(&port->raddr.addr, port->raddr.salen,
+								  remote_host, sizeof(remote_host),
+								  remote_port, sizeof(remote_port),
+								  NI_NUMERICHOST | NI_NUMERICSERV);
+		port->remote_host = MemoryContextStrdup(TopMemoryContext, remote_host);
+		port->remote_port = MemoryContextStrdup(TopMemoryContext, remote_port);
+
+		whereToSendOutput = DestRemote;
+		ClientAuthInProgress = true;
+		lot_demote_fatal = true;
+		set_ps_display("startup");
+
+		oldcxt = CurrentMemoryContext;
