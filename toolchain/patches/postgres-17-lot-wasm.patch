+/*
+ * Is the connection just accepted on fd a cancel request?  (Those arrive
+ * on a new connection; with one process there is never a running query
+ * left to cancel by the time we read it.)  Consumes and drops it if so.
+ */
+static bool
+lot_is_cancel_request(pgsocket fd)
+{
+	struct pollfd pfd;
+	uint32		hdr[4];
+	ssize_t		n;
+
+	pfd.fd = fd;
+	pfd.events = POLLIN;
+	pfd.revents = 0;
+	if (poll(&pfd, 1, 1000) <= 0)
+		return false;			/* nothing sent yet: treat as a real client */
+	n = recv(fd, hdr, sizeof(hdr), MSG_PEEK);
+	if (n < 8)
+		return false;
+	if (pg_ntoh32(hdr[0]) == 16 &&
+		pg_ntoh32(hdr[1]) == (uint32) CANCEL_REQUEST_CODE)
+	{
+		(void) recv(fd, hdr, sizeof(hdr), 0);
+		return true;
+	}
+	return false;
+}
