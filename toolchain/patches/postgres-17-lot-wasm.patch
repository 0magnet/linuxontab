+#ifdef LOT_WASM
 /* ----------------------------------------------------------------
+ * LinuxOnTab single-process server, session side
+ *
+ * On the LinuxOnTab wasm guest every process is a separate wasm instance and
+ * nothing is shared between them, so the postmaster cannot fork backends that
+ * share a buffer pool.  Instead main.c runs a stand-alone backend in "server
+ * mode": it listens on the usual TCP/Unix sockets itself and serves one
+ * client at a time over the normal FE/BE protocol.  A client's disconnect
+ * ends its session (open transaction rolled back, then the equivalent of
+ * DISCARD ALL) and the next queued client is accepted.  The accept/startup
+ * packet side lives in backend_startup.c.
+ * ----------------------------------------------------------------
+ */
+bool		lot_server_mode = false;
+static bool lot_client_attached = false;
+static char *lot_dbname = NULL;
+
+/* drop the current client and forget its session state */
+static void
+lot_end_client(void)
+{
+	whereToSendOutput = DestNone;
+	lot_client_attached = false;
+	pq_lot_switch_client(NULL);
+	disable_all_timeouts(false);
+	QueryCancelPending = false;
+	AbortOutOfAnyTransaction();
+	exec_simple_query("DISCARD ALL");
+}
+
+/* role, options and greeting for a freshly accepted client */
+static void
+lot_session_setup(Port *port)
+{
+	Oid			roleid;
+	HeapTuple	roleTup;
+	ListCell   *gucopts;
+	StringInfoData buf;
+
+	StartTransactionCommand();
+
+	/* trust authentication: any existing role that may log in */
+	roleid = get_role_oid(port->user_name, true);
+	if (!OidIsValid(roleid))
+		ereport(ERROR,
+				(errcode(ERRCODE_INVALID_AUTHORIZATION_SPECIFICATION),
+				 errmsg("role \"%s\" does not exist", port->user_name)));
+	roleTup = SearchSysCache1(AUTHOID, ObjectIdGetDatum(roleid));
+	if (HeapTupleIsValid(roleTup))
+	{
+		bool		canlogin = ((Form_pg_authid) GETSTRUCT(roleTup))->rolcanlogin;
+
+		ReleaseSysCache(roleTup);
+		if (!canlogin)
+			ereport(ERROR,
+					(errcode(ERRCODE_INVALID_AUTHORIZATION_SPECIFICATION),
+					 errmsg("role \"%s\" is not permitted to log in",
+							port->user_name)));
+	}
+
+	/* a backend attaches to one database for life: re-exec for another */
+	if (strcmp(port->database_name, lot_dbname) != 0)
+	{
+		Oid			dboid = get_database_oid(port->database_name, true);
+		HeapTuple	dbTup;
+		bool		allowconn = false;
+
+		if (!OidIsValid(dboid))
+			ereport(ERROR,
+					(errcode(ERRCODE_UNDEFINED_DATABASE),
+					 errmsg("database \"%s\" does not exist",
+							port->database_name)));
+		dbTup = SearchSysCache1(DATABASEOID, ObjectIdGetDatum(dboid));
+		if (HeapTupleIsValid(dbTup))
+		{
+			allowconn = ((Form_pg_database) GETSTRUCT(dbTup))->datallowconn;
+			ReleaseSysCache(dbTup);
+		}
+		if (!allowconn)
+			ereport(ERROR,
+					(errcode(ERRCODE_OBJECT_NOT_IN_PREREQUISITE_STATE),
+					 errmsg("database \"%s\" is not currently accepting connections",
+							port->database_name)));
+		CommitTransactionCommand();
+		lot_server_handoff(port, lot_argv);
+	}
+
+	if (roleid != GetAuthenticatedUserId())
+		SetConfigOption("session_authorization", port->user_name,
+						PGC_SUSET, PGC_S_SESSION);
+
+	if (port->cmdline_options != NULL && port->cmdline_options[0] != '\0')
+		ereport(WARNING,
+				(errmsg("startup \"options\" are ignored by this server: %s",
+						port->cmdline_options)));
+
+	/* GUC settings from the startup packet (client_encoding, ...) */
+	gucopts = list_head(port->guc_options);
+	while (gucopts)
+	{
+		char	   *name;
+		char	   *value;
+
+		name = lfirst(gucopts);
+		gucopts = lnext(port->guc_options, gucopts);
+		value = lfirst(gucopts);
+		gucopts = lnext(port->guc_options, gucopts);
+		(void) set_config_option(name, value, PGC_SUSET, PGC_S_SESSION,
+								 GUC_ACTION_SET, true, WARNING, false);
+	}
+
+	CommitTransactionCommand();
+
+	pq_beginmessage(&buf, PqMsg_AuthenticationRequest);
+	pq_sendint32(&buf, (int32) AUTH_REQ_OK);
+	pq_endmessage(&buf);
+
+	BeginReportingGUCOptions();
+
+	pq_beginmessage(&buf, PqMsg_BackendKeyData);
+	pq_sendint32(&buf, (int32) MyProcPid);
+	pq_sendint32(&buf, (int32) MyCancelKey);
+	pq_endmessage(&buf);
+	/* ReadyForQuery (from the main loop) flushes */
+}
+
+/* block until the next client has connected and been greeted */
+static void
+lot_start_client(void)
+{
+	for (;;)
+	{
+		Port	   *port = lot_server_accept();
+		MemoryContext oldcxt = CurrentMemoryContext;
+		volatile bool ok = true;
+
+		lot_client_attached = true;
+		PG_TRY();
+		{
+			lot_session_setup(port);
+		}
+		PG_CATCH();
+		{
+			MemoryContextSwitchTo(oldcxt);
+			EmitErrorReport();
+			FlushErrorState();
+			ok = false;
+		}
+		PG_END_TRY();
+		if (ok)
+		{
+			if (port->remote_port[0] != '\0')
+				elog(LOG, "client connected: user=%s database=%s host=%s port=%s",
+					 port->user_name, port->database_name,
+					 port->remote_host, port->remote_port);
+			else
+				elog(LOG, "client connected: user=%s database=%s (local socket)",
+					 port->user_name, port->database_name);
+			return;
+		}
+		pq_flush();
+		lot_end_client();
+	}
+}
