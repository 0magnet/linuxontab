+/* adopt a client the previous server process accepted (database switch) */
+static Port *
+lot_adopt_handoff_client(void)
+{
+	char	   *fdstr = getenv("LOT_PG_CLIENT_FD");
+	ClientSocket client_sock;
+	MemoryContext oldcxt;
+	Port	   *port;
+	char	   *gucs;
+
+	if (fdstr == NULL)
+		return NULL;
+	memset(&client_sock, 0, sizeof(client_sock));
+	client_sock.sock = atoi(fdstr);
+	client_sock.raddr.salen = sizeof(client_sock.raddr.addr);
+	if (getpeername(client_sock.sock, (struct sockaddr *) &client_sock.raddr.addr,
+					&client_sock.raddr.salen) < 0)
+		client_sock.raddr.salen = 0;
+
+	oldcxt = MemoryContextSwitchTo(TopMemoryContext);
+	ReserveExternalFD();
+	port = MyProcPort = pq_init(&client_sock);
+	port->remote_host = "";
+	port->remote_port = "";
+	port->user_name = pstrdup(getenv("LOT_PG_USER") ? getenv("LOT_PG_USER") : "postgres");
+	port->database_name = pstrdup(getenv("LOT_PG_DB") ? getenv("LOT_PG_DB") : "postgres");
+	gucs = getenv("LOT_PG_GUCS");
+	if (gucs != NULL && gucs[0] != '\0')
+	{
+		char	   *s = pstrdup(gucs);
+		char	   *p = s;
+
+		/* name \001 value \001 name \001 value ... */
+		while (p && *p)
+		{
+			char	   *sep = strchr(p, '\001');
+
+			if (sep)
+				*sep = '\0';
+			port->guc_options = lappend(port->guc_options, pstrdup(p));
+			p = sep ? sep + 1 : NULL;
+		}
+		if (list_length(port->guc_options) % 2 != 0)
+			port->guc_options = NIL;
+	}
+	if (getenv("LOT_PG_PROTO"))
+		FrontendProtocol = (ProtocolVersion) strtoul(getenv("LOT_PG_PROTO"), NULL, 10);
+	MemoryContextSwitchTo(oldcxt);
+
+	unsetenv("LOT_PG_CLIENT_FD");
+	unsetenv("LOT_PG_USER");
+	unsetenv("LOT_PG_DB");
+	unsetenv("LOT_PG_GUCS");
+	unsetenv("LOT_PG_PROTO");
+	whereToSendOutput = DestRemote;
+	return port;
+}
